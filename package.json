{
  "name": "servesafe-browser",
  "version": "1.0.0",
  "description": "A modern, secure desktop browser built with Electron",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "electron-store": "^12.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.servesafe.browser",
    "productName": "ServeSafe Browser",
    "icon": "build/icon",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
